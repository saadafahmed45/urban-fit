# MongoDB Atlas Configuration
MONGODB_URI=mongodb://localhost:27017/urban_fit
MONGODB_DB=urban_fit

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# NextAuth.js Configuration (Customer Authentication)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=urban_fit_nextauth_super_secret_session_key_2026_change_in_production

# Optional Google OAuth Provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin JWT Secret & Site Configuration
JWT_SECRET=urban_fit_super_secret_jwt_key_streetwear_2026_change_in_production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
